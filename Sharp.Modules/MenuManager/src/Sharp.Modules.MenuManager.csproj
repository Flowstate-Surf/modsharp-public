<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <LangVersion>13</LangVersion>
        <Nullable>enable</Nullable>
        <AssemblyName>MenuManager</AssemblyName>
        <RootNamespace>Sharp.Modules.MenuManager</RootNamespace>
        <VersionPrefix>1.0</VersionPrefix>
        <VersionSuffix>0</VersionSuffix>
        <Version>$(VersionPrefix).$(VersionSuffix)</Version>
        <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/Flowstate-Surf/modsharp-public</PackageProjectUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <IncludeSymbols>false</IncludeSymbols>
        <SourceControlInformationFeatureSupported>true</SourceControlInformationFeatureSupported>
        <Copyright>©2025 Flowstate-Surf</Copyright>
        <Authors>schwarper (original), Flowstate-Surf (port)</Authors>
        <Description>Menu Manager module for CS2 - Ported from CS2MenuManager</Description>
        <PackageTags>ModSharp;CS2;Menu</PackageTags>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/Flowstate-Surf/modsharp-public</RepositoryUrl>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <BaseOutputPath>../../../.build/Sharp.Modules/MenuManager/</BaseOutputPath>
        <PlatformTarget>x64</PlatformTarget>
        <PackageId>ModSharp.$(AssemblyName)</PackageId>
        <Title>ModSharp.$(AssemblyName)</Title>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\Sharp.Shared\Sharp.Shared.csproj" Private="false" ExcludeAssets="runtime" />
    </ItemGroup>

</Project>
